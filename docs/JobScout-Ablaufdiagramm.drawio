<mxfile host="app.diagrams.net"><diagram name="JobScout Ablauf" id="js1"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2700" pageHeight="6000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="start" value="0 · Start &amp; Architektur: alles läuft lokal auf dem Mac (nur 127.0.0.1), eine Python-Standardbibliothek-App ohne Build-Schritt" style="swimlane;startSize=34;html=1;rounded=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="2590" height="130" as="geometry"/></mxCell>
<mxCell id="col12" value="12 · Unterlagen &amp;amp; Bewerbungsmappe" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1970" y="4656" width="650" height="1969" as="geometry"/></mxCell>
<mxCell id="col11" value="11 · Profil, Lebenslauf-Editor, PDF-Import &amp;amp; -Export" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1290" y="4656" width="650" height="1985" as="geometry"/></mxCell>
<mxCell id="col10" value="10 · Skill-Radar, Skill-Editor &amp;amp; Skill-Gap-Analyse" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="4656" width="600" height="1552" as="geometry"/></mxCell>
<mxCell id="col9" value="9 · Scoring-Engine: Live-Vorschau &amp;amp; Neu bewerten" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="4656" width="600" height="1255" as="geometry"/></mxCell>
<mxCell id="col8" value="8 · Claude-Workflows im Terminal: Bewerbung &amp;amp; Interview" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1980" y="2660" width="640" height="1906" as="geometry"/></mxCell>
<mxCell id="col7" value="7 · Pipeline: Bewerbungs-Tracker" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#ffe6cc;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1330" y="2660" width="620" height="1433" as="geometry"/></mxCell>
<mxCell id="col6" value="6 · Dashboard, Stellen &amp;amp; Merkliste" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="680" y="2660" width="620" height="1260" as="geometry"/></mxCell>
<mxCell id="col5" value="5 · Cockpit-Server: Anfrage-Ablauf &amp;amp; Hintergrund-Tasks" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#e1f5fe;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="2660" width="620" height="1770" as="geometry"/></mxCell>
<mxCell id="col4" value="4 · LinkedIn-Brücke (nur manuell) &amp;amp; Zeitplan (launchd – stillgelegt)" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#f8cecc;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1940" y="230" width="680" height="1096" as="geometry"/></mxCell>
<mxCell id="col3" value="3 · Suchlauf (job_scout.py) &amp;amp; Scoring" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#fff2cc;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1150" y="230" width="760" height="2340" as="geometry"/></mxCell>
<mxCell id="col2" value="2 · Quellen-Adapter (fetch_… in job_scout.py)" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#dae8fc;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="230" width="540" height="1085" as="geometry"/></mxCell>
<mxCell id="col1" value="1 · Einstellungen &amp;amp; Suchprofil (Cockpit › Einstellungen)" style="swimlane;startSize=36;html=1;rounded=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="520" height="1185" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;Cockpit › Einstellungen&lt;/b&gt;&lt;br&gt;Reiter: Suchprofil (Suchbegriffe, Ort, Umkreis, Remote bundesweit, Quellen an/aus, BA-Details, Mitteilungs-Schwelle) · Scoring-Engine · Ausschlüsse · Skill-Profil · Bewerbung" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col1"><mxGeometry x="20" y="48" width="260" height="118" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;POST /api/einstellungen → speichere_einstellungen()&lt;/b&gt;&lt;br&gt;_pruefe_einstellungen() prüft jeden Wert per _validiere() gegen Typ und Form der Standardwerte (Zahl, Text, Liste, ja/nein); Listen werden bereinigt, Duplikate entfernt, Stichwörter kleingeschrieben" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col1"><mxGeometry x="20" y="196" width="260" height="132" as="geometry"/></mxCell>
<mxCell id="a3" value="Eingaben gültig?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col1"><mxGeometry x="20" y="358" width="260" height="84" as="geometry"/></mxCell>
<mxCell id="a4" value="&lt;b&gt;Fehlermeldung im Cockpit (HTTP 400), nichts wird gespeichert&lt;/b&gt;&lt;br&gt;mind. 1 Suchbegriff · mind. 1 Rollen-Keyword · Frische ≥ 1 Tag · Tonfall und Sprache aus Auswahlliste" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col1"><mxGeometry x="310" y="341" width="190" height="118" as="geometry"/></mxCell>
<mxCell id="a5" value="&lt;b&gt;Atomar speichern&lt;/b&gt;&lt;br&gt;einstellungen.json.tmp schreiben, dann os.replace() – nie eine halb geschriebene Datei" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col1"><mxGeometry x="20" y="472" width="260" height="75" as="geometry"/></mxCell>
<mxCell id="a6" value="einstellungen.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col1"><mxGeometry x="310" y="486" width="190" height="48" as="geometry"/></mxCell>
<mxCell id="a7" value="&lt;b&gt;Standardwerte + Überschreibung&lt;/b&gt;&lt;br&gt;job_scout.py: PROFIL und SCORE_REGELN im Code sind der Standard; wende_einstellungen_an() ersetzt nur Schlüssel, die in der JSON stehen – auch bei Läufen ohne Cockpit. skill_radar.py: genauso (mische_katalog)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col1"><mxGeometry x="20" y="577" width="260" height="118" as="geometry"/></mxCell>
<mxCell id="a8" value="&lt;b&gt;GET /api/einstellungen → einstellungen_api()&lt;/b&gt;&lt;br&gt;gespeicherte Werte per _mische() über den Standard gelegt; der Block „standard“ speist „Standard wiederherstellen“" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col1"><mxGeometry x="20" y="725" width="260" height="104" as="geometry"/></mxCell>
<mxCell id="a9" value="&lt;b&gt;„Standard wiederherstellen“ → setze_einstellungen_zurueck()&lt;/b&gt;&lt;br&gt;einstellungen.json wird zu einstellungen.json.bak umbenannt – die alte Datei bleibt erhalten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col1"><mxGeometry x="20" y="859" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="a10" value="einstellungen.json.bak" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col1"><mxGeometry x="310" y="880" width="190" height="48" as="geometry"/></mxCell>
<mxCell id="a11" value="&lt;b&gt;Was in einstellungen.json steht&lt;/b&gt;&lt;br&gt;• profil: suchbegriffe, ort, umkreis_km, remote_suche, himalayas_land, quellen, ba_details_top_n, benachrichtigung_ab_score&lt;br&gt;• score_regeln: titel_/text_/malus_/titel_malus_keywords, remote_bonus, lokale_orte, lokal_bonus, frische_tage, frische_bonus_max, blacklist, firmen_blacklist&lt;br&gt;• skill_status (vorhanden / weiterbildung) und skill_katalog_eigen&lt;br&gt;• bewerbung: followup_tage, min_score, max_stellen, tonfall, sprache, zusatz" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bfa95a;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;" vertex="1" parent="col1"><mxGeometry x="20" y="979" width="260" height="178" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;b&gt;job_scout.main() ruft die Fetcher auf&lt;/b&gt;&lt;br&gt;je Quelle eine Funktion → list[Job]. Job = Dataclass mit titel, firma, ort, veroeffentlicht, url, quelle, remote, beschreibung, neu, score, score_gruende" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col2"><mxGeometry x="20" y="48" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;b&gt;fetch_arbeitsagentur(was, wo, umkreis, nur_remote)&lt;/b&gt;&lt;br&gt;GET …/jobsuche-service/pc/v6/jobs · öffentlicher X-API-Key · 50 pro Seite, max. 3 Seiten · wo+umkreis (Standard 25 km) · zweiter Aufruf ohne Ort mit arbeitszeit=ho für bundesweite Remote-Stellen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col2"><mxGeometry x="20" y="168" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="b3" value="BA Jobsuche-API v6" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="col2"><mxGeometry x="390" y="191" width="130" height="44" as="geometry"/></mxCell>
<mxCell id="b4" value="&lt;b&gt;HTTP 200 und Treffer?&lt;/b&gt;&lt;br&gt;(gilt für jede Quelle)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col2"><mxGeometry x="20" y="288" width="340" height="84" as="geometry"/></mxCell>
<mxCell id="b5" value="[WARN] auf stderr, Schleife dieser Quelle bricht ab – der Lauf geht mit den übrigen Quellen weiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col2"><mxGeometry x="390" y="278" width="130" height="104" as="geometry"/></mxCell>
<mxCell id="b6" value="&lt;b&gt;fetch_adzuna(was, wo, umkreis_km)&lt;/b&gt;&lt;br&gt;nur mit ADZUNA_APP_ID + ADZUNA_APP_KEY aus .env, sonst „übersprungen“ (INFO) · sort_by=date, 50 pro Seite, max. 2 Seiten · zweiter Aufruf „&amp;lt;Begriff&amp;gt; remote“ ohne Ort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col2"><mxGeometry x="20" y="402" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="b7" value="Adzuna-API" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="col2"><mxGeometry x="390" y="425" width="130" height="44" as="geometry"/></mxCell>
<mxCell id="b8" value="&lt;b&gt;fetch_himalayas(was, land=Germany)&lt;/b&gt;&lt;br&gt;Parameter q + country, 20 pro Seite, max. 2 Seiten, stoppt auf der letzten Seite · alle Treffer gelten als remote=True (reine Remote-Jobs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col2"><mxGeometry x="20" y="522" width="340" height="75" as="geometry"/></mxCell>
<mxCell id="b9" value="Himalayas-API" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="col2"><mxGeometry x="390" y="538" width="130" height="44" as="geometry"/></mxCell>
<mxCell id="b10" value="&lt;b&gt;fetch_arbeitnow()&lt;/b&gt;&lt;br&gt;einmal pro Lauf, nicht pro Begriff: die API hat keinen Suchparameter – gefiltert wird erst durch das Scoring · remote-Flag kommt von der API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col2"><mxGeometry x="20" y="627" width="340" height="75" as="geometry"/></mxCell>
<mxCell id="b11" value="Arbeitnow-API" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="col2"><mxGeometry x="390" y="642" width="130" height="44" as="geometry"/></mxCell>
<mxCell id="b12" value="&lt;b&gt;lade_linkedin_datei()&lt;/b&gt;&lt;br&gt;liest linkedin_treffer.json, falls vorhanden (Quelle „LinkedIn“) und löscht sie danach – so landen keine veralteten Treffer im nächsten Lauf (→ Spalte 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col2"><mxGeometry x="20" y="732" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="b13" value="&lt;b&gt;Duplikat-Erkennung beim Sammeln&lt;/b&gt;&lt;br&gt;alle.setdefault(job.key, job): Job.key = Titel + Firma, normalisiert (nur Buchstaben und Ziffern, klein) – die erste Fundstelle gewinnt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col2"><mxGeometry x="20" y="852" width="340" height="75" as="geometry"/></mxCell>
<mxCell id="b14" value="&lt;b&gt;Beschreibungen&lt;/b&gt;&lt;br&gt;• BA liefert in der Trefferliste keine → wird später für die Top-Treffer nachgeladen (Spalte 3)&lt;br&gt;• Arbeitnow, Adzuna, Himalayas: bis 3000 Zeichen, HTML-Tags entfernt&lt;br&gt;• Timeout aller Abfragen: 15 s" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bfa95a;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;" vertex="1" parent="col2"><mxGeometry x="20" y="957" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;Auslöser&lt;/b&gt;&lt;br&gt;Cockpit-Seitenleiste „Neue Stellen suchen“ oder Automatisierungen › „Jetzt starten“ (→ Spalte 5) · Terminal: python3 job_scout.py · ./run_job_scout.sh · früher launchd Mo+Do 07:30 (Spalte 4)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col3"><mxGeometry x="20" y="48" width="420" height="90" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;run_job_scout.sh&lt;/b&gt;&lt;br&gt;Python 3.9 aus den CommandLineTools (hat „requests“) startet job_scout.py, Ausgabe wird an lauf.log angehängt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="168" width="420" height="61" as="geometry"/></mxCell>
<mxCell id="c3" value="lauf.log" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col3"><mxGeometry x="470" y="174" width="270" height="48" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;Start: lade_env() + Einstellungen&lt;/b&gt;&lt;br&gt;.env → os.environ (setdefault, Zugangsdaten nie im Git) · wende_einstellungen_an(einstellungen.json) überschreibt PROFIL / SCORE_REGELN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="259" width="420" height="75" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;main(): Stellen sammeln (→ Spalte 2)&lt;/b&gt;&lt;br&gt;je Suchbegriff BA (Ort + Umkreis, optional Remote bundesweit), Adzuna, Himalayas · danach einmal Arbeitnow · dann die LinkedIn-Datei → alle: dict[Job.key → Job]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="364" width="420" height="75" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;score_job(job) für jede Stelle&lt;/b&gt;&lt;br&gt;bewertet nach SCORE_REGELN, Ergebnis 0–100 plus Begründungsliste (score_gruende). Alle Treffer-Prüfungen laufen über enthaelt_wort() = Wortgrenzen-Regex: „ki“ trifft nicht „Logistik“, „hunter“ nicht „Headhunter“" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="469" width="420" height="90" as="geometry"/></mxCell>
<mxCell id="c7" value="Blacklist-Treffer?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col3"><mxGeometry x="20" y="589" width="420" height="84" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;score = −1, Grund „Ausschluss: …“ bzw. „Firma gesperrt: …“&lt;/b&gt;&lt;br&gt;Begriffe aus blacklist (z. B. Zeitarbeit, Arbeitnehmerüberlassung, d2d) im Titel/Firma/Text, firmen_blacklist im Firmennamen – die Stelle fällt später raus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="470" y="579" width="270" height="104" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Titel-Keywords: nur der beste Treffer zählt&lt;/b&gt;&lt;br&gt;titel_keywords (inside sales +25, customer success +26, account manager +24, kundenberater +24 …) – sonst würden sich Synonyme stapeln" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="703" width="420" height="75" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;Text-Keywords: stapeln sich&lt;/b&gt;&lt;br&gt;in Titel + Firma + Beschreibung: saas +15, hubspot +14, salesforce +14, ki +10, crm +8, b2b +8 … (+4 bis +15 je Begriff)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="808" width="420" height="61" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;Malus-Keywords prüfen&lt;/b&gt;&lt;br&gt;kaltakquise −18, cold calling −15, hunter −15, outbound −12, ote −10 … – Abwertung, kein Ausschluss. ist_verneint() sucht 25 Zeichen davor nach kein/keine/nicht/ohne/no/not/without" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="899" width="420" height="75" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Alle Vorkommen verneint?&lt;/b&gt;&lt;br&gt;(„keine Kaltakquise“)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col3"><mxGeometry x="20" y="1004" width="420" height="84" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;Bonus statt Malus&lt;/b&gt;&lt;br&gt;Verneinung = Pluspunkte (z. B. +18 statt −18)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col3"><mxGeometry x="470" y="1016" width="270" height="61" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;Normaler Malus abgezogen&lt;/b&gt;&lt;br&gt;mindestens ein Vorkommen ist nicht verneint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="1118" width="420" height="47" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;Titel-Malus&lt;/b&gt;&lt;br&gt;nur wenn der Begriff im Stellentitel steht: senior −20, head of −25, lead −15, teamleiter −15, director −25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="1195" width="420" height="61" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;Remote- und Lokal-Bonus&lt;/b&gt;&lt;br&gt;remote-Flag, „remote“, „home office“ oder „homeoffice“ im Text: +20 · Ort enthält Eintrag aus lokale_orte (Leipzig, Halle, Schkeuditz, Markkleeberg, Borna …): +20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="1286" width="420" height="75" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;Frische-Bonus&lt;/b&gt;&lt;br&gt;bis +10, linear fallend: frische_bonus_max × (1 − Alter / frische_tage), nur innerhalb von 14 Tagen · Datum ohne Zeitzone gilt als UTC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="1391" width="420" height="75" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;Score festlegen&lt;/b&gt;&lt;br&gt;max(min(Summe, 100), 0) – Gründe bleiben als Text an der Stelle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="1496" width="420" height="61" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;Sortieren und Aussortieren&lt;/b&gt;&lt;br&gt;score ≥ 0 bleibt, absteigend nach Score · Zahl der Blacklist-Treffer wird gemeldet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="1587" width="420" height="61" as="geometry"/></mxCell>
<mxCell id="c20" value="ba_details_top_n &amp;gt; 0 (Standard 40)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col3"><mxGeometry x="20" y="1678" width="420" height="84" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;lade_ba_beschreibung(job) für BA-Top-Treffer ohne Beschreibung&lt;/b&gt;&lt;br&gt;refnr base64-kodiert → GET …/v4/jobdetails/&amp;lt;ref&amp;gt; · setzt remote bei „homeofficemoeglich“ · 0,2 s Pause je Stelle · danach score_job() erneut, Liste neu sortieren" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="470" y="1661" width="270" height="118" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;markiere_neue_jobs(relevant)&lt;/b&gt;&lt;br&gt;SQLite jobs_gesehen.db, Tabelle gesehen: unbekannter key → neu=True + INSERT (key, erster_lauf, titel, firma, ort, url, quelle, score, beschreibung) · bekannter key → Score aktualisiert, Beschreibung nur wenn länger · fehlende Spalten per ALTER TABLE ergänzt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="1792" width="420" height="104" as="geometry"/></mxCell>
<mxCell id="c23" value="jobs_gesehen.db (Tabelle gesehen)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col3"><mxGeometry x="470" y="1820" width="270" height="48" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b&gt;Ausgabe schreiben&lt;/b&gt;&lt;br&gt;schreibe_csv() → jobs_ranked.csv (; getrennt, UTF-8-BOM: Neu, Score, Titel, Firma, Ort, Remote, Veröffentlicht, Gründe, Link, Quelle) · schreibe_html() → jobs_report.html (Score-Ampel: ≥ 60 grün, ≥ 35 orange, sonst grau)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="1926" width="420" height="90" as="geometry"/></mxCell>
<mxCell id="c25" value="jobs_ranked.csv + jobs_report.html" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col3"><mxGeometry x="470" y="1947" width="270" height="48" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;Neue Stelle mit Score ≥ 60?&lt;/b&gt;&lt;br&gt;(benachrichtigung_ab_score)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col3"><mxGeometry x="20" y="2046" width="420" height="84" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;macos_benachrichtigung()&lt;/b&gt;&lt;br&gt;osascript-Mitteilung „N neue Top-Treffer“ mit bester Stelle · nur auf macOS, Fehler werden ignoriert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="470" y="2050" width="270" height="75" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;Konsole: Top 5&lt;/b&gt;&lt;br&gt;mit NEU-Markierung, Score, Titel, Firma, Ort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col3"><mxGeometry x="20" y="2160" width="420" height="47" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;Fertig&lt;/b&gt;&lt;br&gt;Cockpit-Task meldet „fertig“ (Exit-Code 0) oder „fehler (Code N)“ – Dashboard und Stellenliste lesen jobs_ranked.csv neu (→ Spalte 6)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col3"><mxGeometry x="20" y="2237" width="420" height="75" as="geometry"/></mxCell>
<mxCell id="d1" value="&lt;b&gt;Marc bittet Claude um LinkedIn-Treffer&lt;/b&gt;&lt;br&gt;in einer laufenden Claude-Code-Session, z. B. „suche LinkedIn-Jobs für Inside Sales“" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col4"><mxGeometry x="20" y="48" width="380" height="61" as="geometry"/></mxCell>
<mxCell id="d2" value="&lt;b&gt;Claude ruft den LinkedIn-MCP live auf&lt;/b&gt;&lt;br&gt;search_jobs und get_job_details liefern rohen, gescrapten Seitentext – keine sauberen Einzelfelder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col4"><mxGeometry x="20" y="139" width="380" height="61" as="geometry"/></mxCell>
<mxCell id="d3" value="LinkedIn-MCP-Server" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="col4"><mxGeometry x="430" y="148" width="230" height="44" as="geometry"/></mxCell>
<mxCell id="d4" value="&lt;b&gt;linkedin_bridge.parse_job_posting(text, job_id)&lt;/b&gt;&lt;br&gt;Rohtext besteht aus Leerzeilen-Blöcken: Firma, Titel, „Ort · Vor N Wochen“ · Zeile „Remote“ oder „Hybrid“ → remote=True · Beschreibung ab „Details zum Jobangebot“ (max. 3000 Zeichen) · _extrahiere_datum() rechnet die Zeitangabe in ein ISO-Datum um" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col4"><mxGeometry x="20" y="230" width="380" height="104" as="geometry"/></mxCell>
<mxCell id="d5" value="&lt;b&gt;speichere_treffer(einträge)&lt;/b&gt;&lt;br&gt;schreibt die normalisierten Treffer als JSON-Liste" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col4"><mxGeometry x="20" y="364" width="380" height="47" as="geometry"/></mxCell>
<mxCell id="d6" value="linkedin_treffer.json (temporär)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col4"><mxGeometry x="430" y="364" width="230" height="48" as="geometry"/></mxCell>
<mxCell id="d7" value="&lt;b&gt;Warum nie automatisch?&lt;/b&gt;&lt;br&gt;• Der LinkedIn-MCP ist nur innerhalb einer Claude-Session aufrufbar, job_scout.py läuft aber auch ohne Claude (Terminal, früher launchd).&lt;br&gt;• Beim nächsten Lauf liest lade_linkedin_datei() (Spalte 2) die Datei ein und löscht sie danach." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bfa95a;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;" vertex="1" parent="col4"><mxGeometry x="20" y="441" width="380" height="100" as="geometry"/></mxCell>
<mxCell id="d8" value="&lt;b&gt;Zeitplan (launchd) – stillgelegt am 31.08.2026&lt;/b&gt;&lt;br&gt;JobScout läuft nicht mehr nach Zeitplan, das Projekt wird umstrukturiert. Die drei LaunchAgents liegen archiviert in launchagents-archiv/ (RunAtLoad = false). Nur Ausladen reichte nicht: launchd lädt beim Anmelden alles aus ~/Library/LaunchAgents wieder." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col4"><mxGeometry x="20" y="571" width="380" height="104" as="geometry"/></mxCell>
<mxCell id="d9" value="&lt;b&gt;com.marcpoenisch.jobscout.plist&lt;/b&gt;&lt;br&gt;Mo + Do, 07:30 → run_job_scout.sh (Spalte 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col4"><mxGeometry x="20" y="705" width="380" height="47" as="geometry"/></mxCell>
<mxCell id="d10" value="&lt;b&gt;com.marcpoenisch.jobscout.bewerbungsworkflow.plist&lt;/b&gt;&lt;br&gt;Mo + Do, 08:00 → run_bewerbungs_workflow.sh: Terminal öffnen, Claude Code mit Bewerbungs-Prompt (Spalte 8). Wartete im Terminal auf Marcs Auswahl – lief also nicht unbeaufsichtigt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col4"><mxGeometry x="20" y="782" width="380" height="90" as="geometry"/></mxCell>
<mxCell id="d11" value="&lt;b&gt;com.marcpoenisch.jobscout.skillgap.plist&lt;/b&gt;&lt;br&gt;1. des Monats, 08:00 → run_skill_gap_analyse.sh (Spalte 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col4"><mxGeometry x="20" y="902" width="380" height="61" as="geometry"/></mxCell>
<mxCell id="d12" value="&lt;b&gt;Heute: Läufe auf Zuruf&lt;/b&gt;&lt;br&gt;Cockpit › Automatisierungen oder run_job_scout.sh, run_bewerbungs_workflow.sh, run_skill_gap_analyse.sh, run_interview_prep.command per Doppelklick" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col4"><mxGeometry x="20" y="993" width="380" height="75" as="geometry"/></mxCell>
<mxCell id="f1" value="&lt;b&gt;Aufruf aus der Oberfläche&lt;/b&gt;&lt;br&gt;app.js: api(url, body) per fetch · Fehler erscheinen als Toast (sicher())" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col5"><mxGeometry x="20" y="48" width="310" height="61" as="geometry"/></mxCell>
<mxCell id="f2" value="&lt;b&gt;Handler._host_ok()&lt;/b&gt;&lt;br&gt;Host-Header muss 127.0.0.1 oder localhost sein (Schutz vor DNS-Rebinding)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="20" y="139" width="310" height="61" as="geometry"/></mxCell>
<mxCell id="f3" value="Host erlaubt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col5"><mxGeometry x="20" y="230" width="310" height="84" as="geometry"/></mxCell>
<mxCell id="f4" value="HTTP 403 „Host nicht erlaubt“" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="360" y="249" width="240" height="46" as="geometry"/></mxCell>
<mxCell id="f5" value="GET oder POST?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col5"><mxGeometry x="20" y="344" width="310" height="84" as="geometry"/></mxCell>
<mxCell id="f6" value="&lt;b&gt;do_GET: lesen&lt;/b&gt;&lt;br&gt;statisch (STATISCH): index.html, app.css, app.js, einstellungen.js, lebenslauf.js, /report/jobs, /report/skills · API: /api/status, /api/jobs, /api/tracker, /api/dokumente, /api/einstellungen, /api/cv, /api/unterlagen, /api/task · /datei/&amp;lt;Pfad&amp;gt; nur aus unterlagen/ (Bild, PDF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="360" y="307" width="240" height="161" as="geometry"/></mxCell>
<mxCell id="f7" value="POST: Header X-JobScout: 1 und Body ≤ 40 MB?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col5"><mxGeometry x="20" y="458" width="310" height="84" as="geometry"/></mxCell>
<mxCell id="f8" value="&lt;b&gt;HTTP 403 „Nicht erlaubt“ / 413 „Anfrage zu groß“&lt;/b&gt;&lt;br&gt;Schutz gegen fremde Webseiten, die per Formular an 127.0.0.1 senden könnten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="360" y="480" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="f9" value="&lt;b&gt;do_POST: json.loads(Body) → Routing nach Pfad&lt;/b&gt;&lt;br&gt;/api/tracker · /api/task · /api/einstellungen (+ /vorschau, /neu_bewerten, /zuruecksetzen) · /api/profil · /api/cv (+ /import, /pdf) · /api/unterlagen/upload, /loeschen, /auslesen · /api/nachweise (+ /auswerten) · /api/mappe · /api/oeffnen · /api/claude/bewerbung, /interview, /workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="20" y="572" width="310" height="132" as="geometry"/></mxCell>
<mxCell id="f10" value="Funktion wirft Fehler?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col5"><mxGeometry x="20" y="734" width="310" height="84" as="geometry"/></mxCell>
<mxCell id="f11" value="ValueError/Exception → HTTP 400 {fehler: …} · subprocess-Fehler → 500 „Start fehlgeschlagen“ · GET-Fehler → 500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="360" y="738" width="240" height="75" as="geometry"/></mxCell>
<mxCell id="f12" value="&lt;b&gt;JSON-Antwort&lt;/b&gt;&lt;br&gt;Content-Type JSON (UTF-8), Cache-Control: no-store" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col5"><mxGeometry x="20" y="848" width="310" height="61" as="geometry"/></mxCell>
<mxCell id="f13" value="&lt;b&gt;POST /api/task {name} → starte_task()&lt;/b&gt;&lt;br&gt;Name nur scout oder radar, sonst „Unbekannte Aufgabe“ · läuft schon (proc.poll() is None) → „Läuft bereits“ · sonst subprocess.Popen im Projektordner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="20" y="939" width="310" height="90" as="geometry"/></mxCell>
<mxCell id="f14" value="Welche Aufgabe?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col5"><mxGeometry x="20" y="1059" width="310" height="84" as="geometry"/></mxCell>
<mxCell id="f15" value="&lt;b&gt;radar: python3 skill_radar.py&lt;/b&gt;&lt;br&gt;stdout/stderr nach .cockpit/skill_radar.log (→ Spalte 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="360" y="1070" width="240" height="61" as="geometry"/></mxCell>
<mxCell id="f16" value="&lt;b&gt;scout: /bin/bash run_job_scout.sh&lt;/b&gt;&lt;br&gt;schreibt selbst nach lauf.log (→ Spalte 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="20" y="1173" width="310" height="47" as="geometry"/></mxCell>
<mxCell id="f17" value="&lt;b&gt;Polling: GET /api/task?name=… alle 2,5 s&lt;/b&gt;&lt;br&gt;_task_info(): bereit | läuft | fertig | fehler (Code N) + letzte 25 Log-Zeilen · bei „fertig“ lädt das Cockpit Status, Stellen und Tracker neu (ladeAlles)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="20" y="1250" width="310" height="90" as="geometry"/></mxCell>
<mxCell id="f18" value="&lt;b&gt;GET /api/status → status_api()&lt;/b&gt;&lt;br&gt;Vorname aus profil.json · jobs_gesamt / neu / top (Score ≥ 50) · Pipeline-Zähler · fällige Follow-ups · Stand (mtime) von jobs_ranked.csv und skill_report.html · Task-Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="20" y="1370" width="310" height="90" as="geometry"/></mxCell>
<mxCell id="f19" value="&lt;b&gt;POST /api/oeffnen → oeffne_datei(rel, finder)&lt;/b&gt;&lt;br&gt;öffnet Dateien mit open bzw. open -R im Finder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="20" y="1490" width="310" height="61" as="geometry"/></mxCell>
<mxCell id="f20" value="Datei auf der Freigabeliste?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col5"><mxGeometry x="20" y="1581" width="310" height="84" as="geometry"/></mxCell>
<mxCell id="f21" value="&lt;b&gt;ValueError „Datei nicht freigegeben“&lt;/b&gt;&lt;br&gt;erlaubt: bewerbungen/, unterlagen/, Interview-Briefings, Master-Lebenslauf, Reports, Tracker, kurs_empfehlungen_*.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col5"><mxGeometry x="360" y="1571" width="240" height="104" as="geometry"/></mxCell>
<mxCell id="f22" value="&lt;b&gt;Datei geöffnet&lt;/b&gt;&lt;br&gt;im Standardprogramm oder im Finder markiert" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col5"><mxGeometry x="20" y="1695" width="310" height="47" as="geometry"/></mxCell>
<mxCell id="g1" value="&lt;b&gt;Dashboard (#dashboard)&lt;/b&gt;&lt;br&gt;Begrüßung mit Vorname aus dem Profil · Stand des letzten Laufs · Kennzahlen: neue Stellen, Score ≥ 50, laufende Bewerbungen, Interviews · beste neue Stellen · Pipeline-Übersicht · Schnellstart-Karten" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col6"><mxGeometry x="20" y="48" width="320" height="104" as="geometry"/></mxCell>
<mxCell id="g2" value="&lt;b&gt;Seitenleiste „Neue Stellen suchen“&lt;/b&gt;&lt;br&gt;POST /api/task scout (Spalte 5) → Spalte 3 · Punkt „läuft“, Hinweis „Suche läuft …“, danach „Letzter Lauf: …“" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col6"><mxGeometry x="20" y="182" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="g3" value="&lt;b&gt;GET /api/jobs → lade_jobs()&lt;/b&gt;&lt;br&gt;liest jobs_ranked.csv (Neu, Score, Titel, Firma, Ort, Remote, Datum, Gründe, Link, Quelle) · im_tracker = Firma steht (normalisiert) schon in bewerbungen_tracker.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col6"><mxGeometry x="20" y="287" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="g4" value="jobs_ranked.csv" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col6"><mxGeometry x="370" y="308" width="230" height="48" as="geometry"/></mxCell>
<mxCell id="g5" value="&lt;b&gt;Stellen (#stellen)&lt;/b&gt;&lt;br&gt;Suche · Mindest-Score (Schieberegler) · nur neue · nur Remote · Quelle · „ohne Tracker-Einträge“ · Scoring-Gründe aufklappbar · Link zum HTML-Report (/report/jobs)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col6"><mxGeometry x="20" y="407" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="g6" value="&lt;b&gt;Stellen auswählen (Merkliste)&lt;/b&gt;&lt;br&gt;je Stelle Schaltfläche „Auswählen“ / „✓ Ausgewählt“ (toggleAuswahl, state.auswahl) · Leiste unten zeigt die gewählten Firmen, „Leeren“ setzt zurück" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col6"><mxGeometry x="20" y="527" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="g7" value="Stellen ausgewählt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col6"><mxGeometry x="20" y="647" width="320" height="84" as="geometry"/></mxCell>
<mxCell id="g8" value="&lt;b&gt;Auswahl-Leiste bleibt ausgeblendet&lt;/b&gt;&lt;br&gt;ein direkter API-Aufruf ohne Stellen liefert ValueError „Keine Stellen ausgewählt“" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col6"><mxGeometry x="370" y="644" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="g9" value="&lt;b&gt;Dialog „Bewerbungsunterlagen erstellen“&lt;/b&gt;&lt;br&gt;„Im Terminal starten“ → POST /api/claude/bewerbung {stellen} (→ Spalte 8) · danach wird die Auswahl geleert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col6"><mxGeometry x="20" y="761" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="g10" value="&lt;b&gt;Automatisierungen (#automationen)&lt;/b&gt;&lt;br&gt;sechs Karten: Job-Scraping · Bewerbungs-Workflow · Interview-Prep · Skill-Radar · Skill-Gap + Kurssuche · Follow-up-Erinnerung · Tasks mit Live-Status und Log (Spalte 5), Workflows per Knopf im Terminal (Spalte 8)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col6"><mxGeometry x="20" y="866" width="320" height="118" as="geometry"/></mxCell>
<mxCell id="g11" value="&lt;b&gt;Interview-Prep (#interview)&lt;/b&gt;&lt;br&gt;Formular: Firma, Position, Datum, Gesprächspartner → POST /api/claude/interview (Spalte 8)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col6"><mxGeometry x="20" y="1014" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="g12" value="&lt;b&gt;Navigation&lt;/b&gt;&lt;br&gt;Hash-Router in app.js: VIEWS = dashboard, stellen, pipeline, dokumente, interview, skills, automationen · profil, lebenslauf und einstellungen kommen aus lebenslauf.js bzw. einstellungen.js. Seitenleiste mit Badges: neue Top-Stellen (Score ≥ 50) und fällige Follow-ups." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bfa95a;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;" vertex="1" parent="col6"><mxGeometry x="20" y="1119" width="320" height="113" as="geometry"/></mxCell>
<mxCell id="h1" value="&lt;b&gt;Pipeline (#pipeline)&lt;/b&gt;&lt;br&gt;Kanban: vorbereitet → beworben → follow-up → interview → absage / angebot · Karten per Drag &amp;amp; Drop, Bearbeiten-Dialog, Unterlagen je Firma öffnen" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col7"><mxGeometry x="20" y="48" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="h2" value="&lt;b&gt;GET /api/tracker → tracker_api()&lt;/b&gt;&lt;br&gt;lade_tracker(): bewerbungen_tracker.csv (; getrennt, UTF-8-BOM), Beispielzeilen mit „(zeile löschen)“ werden ausgeblendet · je Eintrag followup_faellig() und dokumente_fuer(Firma)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col7"><mxGeometry x="20" y="168" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="h3" value="bewerbungen_tracker.csv" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col7"><mxGeometry x="370" y="189" width="230" height="48" as="geometry"/></mxCell>
<mxCell id="h4" value="&lt;b&gt;dokumente_fuer(firma)&lt;/b&gt;&lt;br&gt;_norm_firma() (nur a–z, 0–9, äöüß) wird gegen Dateinamen in bewerbungen/ und Interview_Briefing_*.docx im Projektordner gematcht" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col7"><mxGeometry x="20" y="288" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="h5" value="Follow-up fällig?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col7"><mxGeometry x="20" y="393" width="320" height="84" as="geometry"/></mxCell>
<mxCell id="h6" value="&lt;b&gt;followup_faellig(): Karte als fällig markiert&lt;/b&gt;&lt;br&gt;Regel: Status „beworben“, Ergebnis leer, Beworben am länger als followup_tage (Standard 12) her · Dashboard listet die Firma unter Follow-up, Seitenleiste zeigt Badge" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col7"><mxGeometry x="370" y="369" width="230" height="132" as="geometry"/></mxCell>
<mxCell id="h7" value="&lt;b&gt;Aktion in der Oberfläche&lt;/b&gt;&lt;br&gt;Neu · Karte verschieben · Bearbeiten · „Ist raus“ · Löschen" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col7"><mxGeometry x="20" y="507" width="320" height="61" as="geometry"/></mxCell>
<mxCell id="h8" value="&lt;b&gt;POST /api/tracker → tracker_aktion(daten)&lt;/b&gt;&lt;br&gt;unter _tracker_lock (Thread-sicher), lädt die CSV frisch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col7"><mxGeometry x="20" y="598" width="320" height="61" as="geometry"/></mxCell>
<mxCell id="h9" value="Eintrag gefunden und Aktion gültig?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col7"><mxGeometry x="20" y="689" width="320" height="84" as="geometry"/></mxCell>
<mxCell id="h10" value="ValueError: „Firma fehlt“ · „Eintrag nicht gefunden“ · „Ungültiger Status“ · „Unbekannte Aktion“" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col7"><mxGeometry x="370" y="700" width="230" height="61" as="geometry"/></mxCell>
<mxCell id="h11" value="&lt;b&gt;Aktionen&lt;/b&gt;&lt;br&gt;• neu: Firma Pflicht, Status Standard „vorbereitet“, Erstellt am = heute&lt;br&gt;• beworben („Ist raus“): Status beworben, Beworben am = heute, Follow-up am = heute + followup_tage (Standard 12, einstellbar 1–90)&lt;br&gt;• update: Felder übernehmen; Status muss in STATUSWERTE stehen; Wechsel auf „beworben“ ohne Datum setzt beide Daten automatisch&lt;br&gt;• loeschen: Zeile entfernen" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bfa95a;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;" vertex="1" parent="col7"><mxGeometry x="20" y="803" width="320" height="152" as="geometry"/></mxCell>
<mxCell id="h12" value="&lt;b&gt;speichere_tracker(rows)&lt;/b&gt;&lt;br&gt;CSV in bewerbungen_tracker.csv.tmp schreiben, dann os.replace() – atomar; danach lädt das Cockpit Tracker und Status neu (ladeTracker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col7"><mxGeometry x="20" y="985" width="320" height="75" as="geometry"/></mxCell>
<mxCell id="h13" value="&lt;b&gt;Karte steht in der neuen Spalte&lt;/b&gt;&lt;br&gt;Pipeline-Zähler im Dashboard und Badge der Seitenleiste aktualisieren sich" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col7"><mxGeometry x="20" y="1090" width="320" height="61" as="geometry"/></mxCell>
<mxCell id="h14" value="&lt;b&gt;Zeilen, die Claude schreibt&lt;/b&gt;&lt;br&gt;der Bewerbungs-Workflow legt neue Zeilen mit „vorbereitet“ an, der Interview-Workflow setzt „interview“ + Gesprächsdatum – direkt in der CSV (Spalte 8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col7"><mxGeometry x="20" y="1181" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="h15" value="&lt;b&gt;Unterlagen › „Nach Bewerbung“&lt;/b&gt;&lt;br&gt;dokumente_api(): Dateien gruppiert nach Firma (Muster Lebenslauf|Anschreiben|Interview_Briefing_&amp;lt;Firma&amp;gt;) mit Pipeline-Status · dazu Master-Dateien und kurs_empfehlungen_*.md" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col7"><mxGeometry x="20" y="1301" width="320" height="104" as="geometry"/></mxCell>
<mxCell id="i1" value="&lt;b&gt;Auslöser&lt;/b&gt;&lt;br&gt;Dashboard-Schnellstart · Merkliste (Spalte 6) · Interview-Formular · Automatisierungen · ./run_bewerbungs_workflow.sh · run_interview_prep.command" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col8"><mxGeometry x="20" y="48" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="i2" value="Welcher Workflow?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col8"><mxGeometry x="20" y="168" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="i3" value="&lt;b&gt;POST /api/claude/interview → prompt_interview()&lt;/b&gt;&lt;br&gt;Pflicht: Firma, Position, Datum, sonst Fehler · Vorlage prompt_interview_prep_template.txt, Platzhalter __FIRMA__, __POSITION__, __DATUM__, __NAME__" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="380" y="151" width="240" height="118" as="geometry"/></mxCell>
<mxCell id="i4" value="&lt;b&gt;POST /api/claude/bewerbung → prompt_bewerbung(stellen)&lt;/b&gt;&lt;br&gt;prompt_bewerbungs_workflow.txt + nummerierte Liste der gewählten Stellen („Auswahl ist erledigt“, Kurzliste überspringen) + bewerbungs_zusatz() · alternativ POST /api/claude/workflow {name}: bewerbung_komplett (Auswahl im Terminal) – skill_gap siehe Spalte 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="20" y="282" width="330" height="132" as="geometry"/></mxCell>
<mxCell id="i5" value="&lt;b&gt;bewerbungs_zusatz()&lt;/b&gt;&lt;br&gt;Einstellungen › Bewerbung: Kurzliste ab Score / max. Stellen (nur wenn ≠ 50 / 15) · Tonfall (wie Anzeige | förmlich | locker) · Sprache (deutsch | wie Anzeige) · eigene Anweisungen · hängt workflow_hinweis() an: Verweis auf profil.json und lebenslauf.json als primäre Stammdaten (Spalte 11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="20" y="444" width="330" height="132" as="geometry"/></mxCell>
<mxCell id="i6" value="&lt;b&gt;oeffne_claude_im_terminal(prompt, kennung)&lt;/b&gt;&lt;br&gt;Prompt → .cockpit/prompt_&amp;lt;kennung&amp;gt;_&amp;lt;Zeit&amp;gt;.txt · AppleScript: Terminal öffnen, cd Projektordner &amp;amp;&amp;amp; claude &quot;$(cat Datei)&quot; · Quoting über _applescript_string() und _shell_quote()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="20" y="606" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="i7" value="Terminal.app + Claude Code CLI" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="col8"><mxGeometry x="380" y="629" width="240" height="44" as="geometry"/></mxCell>
<mxCell id="i8" value="&lt;b&gt;Bewerbung: Follow-ups prüfen&lt;/b&gt;&lt;br&gt;Tracker-Zeilen mit Status „beworben“, länger als 12 Tage, Ergebnis leer → Erinnerung + Status „follow-up“" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="20" y="726" width="330" height="75" as="geometry"/></mxCell>
<mxCell id="i9" value="&lt;b&gt;Bewerbung: Kurzliste&lt;/b&gt;&lt;br&gt;neue Stellen mit Score ≥ 50 aus jobs_ranked.csv (max. 15), sonst Top 5 · Firmen, die schon im Tracker stehen, werden übersprungen und gemeldet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="20" y="831" width="330" height="75" as="geometry"/></mxCell>
<mxCell id="i10" value="Auswahl getroffen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col8"><mxGeometry x="20" y="936" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="i11" value="&lt;b&gt;Ende bis zum nächsten Lauf&lt;/b&gt;&lt;br&gt;Ohne Auswahl passiert nichts – der Workflow wartet im Terminal auf Marc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="380" y="940" width="240" height="75" as="geometry"/></mxCell>
<mxCell id="i12" value="&lt;b&gt;Je Stelle: Ausschreibung + Firmen-Homepage lesen&lt;/b&gt;&lt;br&gt;Anforderungen, Tonfall und Stil der Anzeige · Produkte, Zielgruppe, Werte der Firma · nicht abrufbar → Marc bitten, den Text einzufügen bzw. Punkt überspringen, nicht raten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="20" y="1050" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="i13" value="&lt;b&gt;Lebenslauf und Anschreiben schreiben&lt;/b&gt;&lt;br&gt;bewerbungen/Lebenslauf_&amp;lt;Firma&amp;gt;.docx aus Lebenslauf_Master.docx (nur vorhandene Fakten, nichts erfinden) · Anschreiben_&amp;lt;Firma&amp;gt;.docx (max. 1 Seite, Sie-Form, Registerwechsel der Anzeige, mind. ein belegter Firmenbezug)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="20" y="1170" width="330" height="104" as="geometry"/></mxCell>
<mxCell id="i14" value="bewerbungen/*.docx" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col8"><mxGeometry x="380" y="1198" width="240" height="48" as="geometry"/></mxCell>
<mxCell id="i15" value="&lt;b&gt;Tracker-Zeile anlegen&lt;/b&gt;&lt;br&gt;Firma, Position, Link, Status „vorbereitet“, Erstellt am = heute (→ Spalte 7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="20" y="1304" width="330" height="61" as="geometry"/></mxCell>
<mxCell id="i16" value="&lt;b&gt;Ausgabe&lt;/b&gt;&lt;br&gt;Dateiliste und Hinweis auf Lücken zwischen Profil und Anforderungen" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col8"><mxGeometry x="20" y="1395" width="330" height="61" as="geometry"/></mxCell>
<mxCell id="i17" value="&lt;b&gt;Marc prüft und sendet ab&lt;/b&gt;&lt;br&gt;dann „Bewerbung bei X ist raus“ oder Knopf „Ist raus“ in der Pipeline → Status beworben, Follow-up +12 Tage (Spalte 7)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col8"><mxGeometry x="20" y="1486" width="330" height="75" as="geometry"/></mxCell>
<mxCell id="i18" value="&lt;b&gt;Interview: Recherche&lt;/b&gt;&lt;br&gt;Firma (Produkte, Kunden, Größe, News der letzten 6 Monate, Wettbewerber) und Gesprächspartner (nur öffentliche Quellen) – Unsicheres als Annahme markiert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="20" y="1591" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="i19" value="&lt;b&gt;Interview: Briefing schreiben&lt;/b&gt;&lt;br&gt;Interview_Briefing_&amp;lt;Firma&amp;gt;.docx: Firmenprofil, 10 Fragen (Quereinsteiger, Kaltakquise, Rollenspiel, Motivation), Antwortgerüste nach STAR nur aus Marcs Fakten, 5 Rückfragen, Checkliste" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col8"><mxGeometry x="20" y="1711" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="i20" value="Interview_Briefing_&amp;lt;Firma&amp;gt;.docx" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col8"><mxGeometry x="380" y="1732" width="240" height="48" as="geometry"/></mxCell>
<mxCell id="i21" value="&lt;b&gt;Tracker: Status „interview“&lt;/b&gt;&lt;br&gt;Gesprächsdatum landet in den Notizen" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col8"><mxGeometry x="20" y="1831" width="330" height="47" as="geometry"/></mxCell>
<mxCell id="j1" value="&lt;b&gt;Einstellungen › Scoring-Engine&lt;/b&gt;&lt;br&gt;Gewichtungen ändern: Rollen im Titel, Keywords in der Anzeige, Malus, Titel-Malus, Remote-/Lokal-Bonus, Orte, Frische, Ausschlüsse" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col9"><mxGeometry x="20" y="48" width="310" height="90" as="geometry"/></mxCell>
<mxCell id="j2" value="&lt;b&gt;planeVorschau(): Debounce&lt;/b&gt;&lt;br&gt;Timer wartet nach der letzten Eingabe · läuft schon eine Vorschau (vorschauLaeuft), wird 300 ms später neu geplant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col9"><mxGeometry x="20" y="168" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="j3" value="&lt;b&gt;POST /api/einstellungen/vorschau → vorschau(daten)&lt;/b&gt;&lt;br&gt;score_regeln werden per _validiere() gegen STANDARD_SCORE_REGELN geprüft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col9"><mxGeometry x="20" y="273" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="j4" value="&lt;b&gt;_bewerte(regeln) zweimal&lt;/b&gt;&lt;br&gt;neue Regeln und – als Vergleichsbasis – die gespeicherten Regeln, beide heute bewertet: so zeigt die Vorschau nur den Effekt der Änderung, nicht z. B. einen inzwischen verfallenen Frische-Bonus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col9"><mxGeometry x="20" y="378" width="310" height="104" as="geometry"/></mxCell>
<mxCell id="j5" value="&lt;b&gt;_bewertbare_jobs()&lt;/b&gt;&lt;br&gt;Stellen aus jobs_ranked.csv + Beschreibung aus jobs_gesehen.db (SELECT key, beschreibung) · Job-Objekte neu aufgebaut" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col9"><mxGeometry x="20" y="512" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="j6" value="jobs_ranked.csv + jobs_gesehen.db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col9"><mxGeometry x="360" y="526" width="220" height="48" as="geometry"/></mxCell>
<mxCell id="j7" value="&lt;b&gt;job_scout.score_job() (Spalte 3)&lt;/b&gt;&lt;br&gt;SCORE_REGELN wird unter _score_lock (Thread-sicher) kurz durch die Vorschau-Regeln ersetzt, danach immer zurückgesetzt (finally)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col9"><mxGeometry x="20" y="617" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="j8" value="&lt;b&gt;Vorschau im Cockpit&lt;/b&gt;&lt;br&gt;Top 8 · Stellen mit Score ≥ 50 vorher/nachher · Zahl Ausgeschlossener · 5 Aufsteiger · 5 Absteiger, jeweils mit Gründen" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col9"><mxGeometry x="20" y="722" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="j9" value="Zufrieden mit den Regeln?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col9"><mxGeometry x="20" y="827" width="310" height="84" as="geometry"/></mxCell>
<mxCell id="j10" value="&lt;b&gt;Weiter anpassen oder verwerfen&lt;/b&gt;&lt;br&gt;nichts wurde gespeichert, die Vorschau rechnet nur im Speicher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col9"><mxGeometry x="360" y="838" width="220" height="61" as="geometry"/></mxCell>
<mxCell id="j11" value="&lt;b&gt;„Speichern“ → speichere_einstellungen()&lt;/b&gt;&lt;br&gt;Prüfung und atomares Schreiben wie in Spalte 1 → einstellungen.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col9"><mxGeometry x="20" y="941" width="310" height="61" as="geometry"/></mxCell>
<mxCell id="j12" value="&lt;b&gt;„Speichern &amp;amp; neu bewerten“ → neu_bewerten()&lt;/b&gt;&lt;br&gt;bewertet alle vorhandenen Stellen mit den gespeicherten Regeln neu, behält score ≥ 0, sortiert absteigend · schreibt jobs_ranked.csv und jobs_report.html unter _tracker_lock – ohne neuen Suchlauf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col9"><mxGeometry x="20" y="1032" width="310" height="104" as="geometry"/></mxCell>
<mxCell id="j13" value="jobs_ranked.csv + jobs_report.html" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col9"><mxGeometry x="360" y="1056" width="220" height="56" as="geometry"/></mxCell>
<mxCell id="j14" value="&lt;b&gt;Ergebnis&lt;/b&gt;&lt;br&gt;„bewertet N, ausgeschlossen M“ – Stellenliste und Dashboard zeigen die neuen Scores" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col9"><mxGeometry x="20" y="1166" width="310" height="61" as="geometry"/></mxCell>
<mxCell id="k1" value="&lt;b&gt;Auslöser&lt;/b&gt;&lt;br&gt;Skill-Radar-Seite „Radar neu berechnen“ (POST /api/task radar) · Automatisierungen · python3 skill_radar.py" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col10"><mxGeometry x="20" y="48" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="k2" value="&lt;b&gt;skill_radar.lade_jobs()&lt;/b&gt;&lt;br&gt;SELECT titel, beschreibung FROM gesehen WHERE Beschreibung nicht leer UND score ≥ MIN_SCORE (20)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col10"><mxGeometry x="20" y="153" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="k3" value="jobs_gesehen.db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col10"><mxGeometry x="360" y="166" width="220" height="48" as="geometry"/></mxCell>
<mxCell id="k4" value="Stellen mit Beschreibung vorhanden?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col10"><mxGeometry x="20" y="258" width="310" height="84" as="geometry"/></mxCell>
<mxCell id="k5" value="&lt;b&gt;Abbruch (Exit 1)&lt;/b&gt;&lt;br&gt;Hinweis: erst job_scout.py mehrmals laufen lassen · unter 10 Stellen läuft die Auswertung nur mit Warnung weiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col10"><mxGeometry x="360" y="255" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="k6" value="&lt;b&gt;SKILL_KATALOG&lt;/b&gt;&lt;br&gt;Standardkatalog + eigene Skills (mische_katalog, einstellungen.json › skill_katalog_eigen) · Status je Skill aus MEIN_STATUS: vorhanden | weiterbildung | Lücke" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col10"><mxGeometry x="20" y="372" width="310" height="90" as="geometry"/></mxCell>
<mxCell id="k7" value="&lt;b&gt;analysiere(jobs)&lt;/b&gt;&lt;br&gt;je Skill: in wie vielen Stellen kommt ein Synonym als ganzes Wort vor (enthaelt_wort)? → Anzahl und Anteil in %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col10"><mxGeometry x="20" y="492" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="k8" value="&lt;b&gt;speichere_snapshot()&lt;/b&gt;&lt;br&gt;Tabelle radar_snapshot(datum, skill, anteil) in jobs_gesehen.db · liefert den letzten Stand vor heute für den Trend zurück" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col10"><mxGeometry x="20" y="597" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="k9" value="&lt;b&gt;schreibe_report()&lt;/b&gt;&lt;br&gt;skill_report.html: Nachfrage-Balken je Skill, Status-Chip, Trendsymbol gegenüber dem letzten Schnappschuss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col10"><mxGeometry x="20" y="702" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="k10" value="skill_report.html" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col10"><mxGeometry x="360" y="716" width="220" height="48" as="geometry"/></mxCell>
<mxCell id="k11" value="&lt;b&gt;Konsole: Top-5-Lücken&lt;/b&gt;&lt;br&gt;nur Skills mit Status „Lücke“ und Anteil &amp;gt; 0, nach Nachfrage sortiert; Cockpit zeigt den Report im iframe (/report/skills)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col10"><mxGeometry x="20" y="807" width="310" height="75" as="geometry"/></mxCell>
<mxCell id="k12" value="&lt;b&gt;Skill-Editor (Einstellungen › Skill-Profil)&lt;/b&gt;&lt;br&gt;Status je Skill setzen · eigene Skills mit Kategorie und Synonymen anlegen/entfernen" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col10"><mxGeometry x="20" y="912" width="310" height="90" as="geometry"/></mxCell>
<mxCell id="k13" value="&lt;b&gt;_pruefe_katalog() beim Speichern&lt;/b&gt;&lt;br&gt;Namen und Kategorien ≤ 60 Zeichen · Skills, die es schon im Standard gibt, fallen weg · Synonyme klein geschrieben, ohne Synonym zählt der Name selbst · skill_status verliert unbekannte Skills" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col10"><mxGeometry x="20" y="1032" width="310" height="104" as="geometry"/></mxCell>
<mxCell id="k14" value="einstellungen.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col10"><mxGeometry x="360" y="1060" width="220" height="48" as="geometry"/></mxCell>
<mxCell id="k15" value="&lt;b&gt;Skill-Gap-Analyse: Claude im Terminal&lt;/b&gt;&lt;br&gt;„Kurse mit Claude suchen“ (/api/claude/workflow skill_gap) oder run_skill_gap_analyse.sh: startet skill_radar.py, liest skill_report.html, fasst Top-5-Lücken und Trends zusammen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col10"><mxGeometry x="20" y="1166" width="310" height="90" as="geometry"/></mxCell>
<mxCell id="k16" value="&lt;b&gt;Kurssuche für die Top-3-Lücken&lt;/b&gt;&lt;br&gt;Reihenfolge: kostenlos (HubSpot Academy, Trailhead, Google, LinkedIn Learning über Bibliothekskarte) → günstig unter 100 € (Udemy) → förderfähig (Bildungsgutschein) · Prüfung: Anbieter seriös, Zertifikat für LinkedIn, max. 3–5 Std./Woche" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col10"><mxGeometry x="20" y="1286" width="310" height="118" as="geometry"/></mxCell>
<mxCell id="k17" value="&lt;b&gt;kurs_empfehlungen_&amp;lt;JAHR-MONAT&amp;gt;.md&lt;/b&gt;&lt;br&gt;je Lücke 1–2 Kurse (Anbieter, Kosten, Dauer, Link, Zertifikat), Fakten und Einschätzung getrennt, max. 1 aktiver Kurs parallel – Marc entscheidet, welchen er startet" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col10"><mxGeometry x="20" y="1434" width="310" height="90" as="geometry"/></mxCell>
<mxCell id="m1" value="&lt;b&gt;Mein Profil (#profil)&lt;/b&gt;&lt;br&gt;Persönliches · Kontakt · Beruflich (Wunschrollen, verfügbar ab, Kündigungsfrist, Gehalt, Arbeitsmodell …) · Sprachen · Stärken · Interessen · Kurzprofil · Motivation &amp;amp; Notizen · Vollständigkeits-Anzeige, Auto-Speichern" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col11"><mxGeometry x="20" y="48" width="330" height="104" as="geometry"/></mxCell>
<mxCell id="m2" value="&lt;b&gt;GET /api/cv → cv_api()&lt;/b&gt;&lt;br&gt;lade_profil() + lade_lebenslauf(): normalisiere() gleicht gegen PROFIL_STANDARD / LEBENSLAUF_STANDARD ab, fehlende Felder werden ergänzt · liefert auch PDF-Quellen und ob Chrome und claude gefunden wurden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col11"><mxGeometry x="20" y="182" width="330" height="104" as="geometry"/></mxCell>
<mxCell id="m3" value="&lt;b&gt;POST /api/profil bzw. /api/cv&lt;/b&gt;&lt;br&gt;speichere_profil() / speichere_lebenslauf(): normalisieren, atomar schreiben" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col11"><mxGeometry x="20" y="316" width="330" height="61" as="geometry"/></mxCell>
<mxCell id="m4" value="profil.json + lebenslauf.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col11"><mxGeometry x="380" y="322" width="250" height="48" as="geometry"/></mxCell>
<mxCell id="m5" value="&lt;b&gt;Lebenslauf-Editor (#lebenslauf)&lt;/b&gt;&lt;br&gt;6 Schritte: Profil · Erfahrung · Bildung · Skills · Extras · Check · Live-Vorschau auf A4, Vorlage „Klassisch“ (einspaltig, echter Text, Standard-Überschriften = ATS-sicher) · Design: Akzentfarbe, Schrift, Überschriften DE/EN, „Auf eine Seite“" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col11"><mxGeometry x="20" y="407" width="330" height="118" as="geometry"/></mxCell>
<mxCell id="m6" value="&lt;b&gt;PDF-Import&lt;/b&gt;&lt;br&gt;PDFs hineinziehen (max. 5, Base64) oder aus Projektordner / bewerbungen wählen → POST /api/cv/import → importiere_pdfs()" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col11"><mxGeometry x="20" y="555" width="330" height="75" as="geometry"/></mxCell>
<mxCell id="m7" value="PDF gültig?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col11"><mxGeometry x="20" y="660" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="m8" value="ValueError: „Datei beschädigt“ · „größer als 15 MB“ · „keine PDF-Datei“ (Signatur %PDF) · „nicht erlaubt“ (Pfad nicht in pdf_quellen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col11"><mxGeometry x="380" y="664" width="250" height="75" as="geometry"/></mxCell>
<mxCell id="m9" value="&lt;b&gt;pdf_text(pdf)&lt;/b&gt;&lt;br&gt;pdftotext (Poppler) + _REPARATUR: kaputte Zeichen repariert, z. B. „KommunikaQonsstärke“ → „Kommunikationsstärke“" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col11"><mxGeometry x="20" y="774" width="330" height="75" as="geometry"/></mxCell>
<mxCell id="m10" value="Poppler: pdftotext" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="col11"><mxGeometry x="380" y="790" width="250" height="44" as="geometry"/></mxCell>
<mxCell id="m11" value="&lt;b&gt;strukturiere_mit_claude(text)&lt;/b&gt;&lt;br&gt;claude -p --output-format json --model sonnet mit IMPORT_PROMPT + JSON-Schema · Arbeitsordner = leeres Temp-Verzeichnis (kein Projektkontext) · Timeout 300 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col11"><mxGeometry x="20" y="879" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="m12" value="Claude Code CLI" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="col11"><mxGeometry x="380" y="902" width="250" height="44" as="geometry"/></mxCell>
<mxCell id="m13" value="&lt;b&gt;Antwort ist gültiges JSON?&lt;/b&gt;&lt;br&gt;(_json_aus_antwort)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col11"><mxGeometry x="20" y="999" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="m14" value="RuntimeError: „Claude hat kein JSON geliefert“ · „claude nicht gefunden“ · „Aufruf fehlgeschlagen“" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col11"><mxGeometry x="380" y="1010" width="250" height="61" as="geometry"/></mxCell>
<mxCell id="m15" value="&lt;b&gt;Vorschlag für Profil + Lebenslauf&lt;/b&gt;&lt;br&gt;normalisiere() auf das Schema · Marc wählt: Lebenslauf ersetzen, Profil ergänzen oder überschreiben · Quellenliste der PDFs" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col11"><mxGeometry x="20" y="1113" width="330" height="75" as="geometry"/></mxCell>
<mxCell id="m16" value="&lt;b&gt;Check-Schritt: ATS-Check (atsCheck, lokal im Browser)&lt;/b&gt;&lt;br&gt;Score 0–100 aus Kontaktdaten, Zusammenfassung, Berufserfahrung, aktiven Formulierungen, messbaren Erfolgen, Skills, Bildung, keine Ich-Form, Länge ≤ 2 Seiten · Stellenanzeige einfügen → Schlüsselbegriffe grün/rot und zusätzliche Wertung „Passung zur Stelle“" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col11"><mxGeometry x="20" y="1218" width="330" height="132" as="geometry"/></mxCell>
<mxCell id="m17" value="&lt;b&gt;PDF-Export → POST /api/cv/pdf → exportiere_pdf()&lt;/b&gt;&lt;br&gt;die UI schickt das fertige CV-HTML (muss &amp;lt;html enthalten, ≤ 2 MB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col11"><mxGeometry x="20" y="1380" width="330" height="61" as="geometry"/></mxCell>
<mxCell id="m18" value="Chrome gefunden?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col11"><mxGeometry x="20" y="1471" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="m19" value="RuntimeError → Hinweis „Drucken → Als PDF sichern“ im Browser als Ausweg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col11"><mxGeometry x="380" y="1490" width="250" height="47" as="geometry"/></mxCell>
<mxCell id="m20" value="&lt;b&gt;_drucke(): Chrome headless --print-to-pdf&lt;/b&gt;&lt;br&gt;Temp-Profil, ohne Kopf-/Fußzeile, Timeout 90 s · Seitenzahl wird aus dem PDF gezählt (_seiten)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col11"><mxGeometry x="20" y="1585" width="330" height="61" as="geometry"/></mxCell>
<mxCell id="m22" value="„Auf eine Seite“ und mehr als 1 Seite?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col11"><mxGeometry x="20" y="1676" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="m23" value="&lt;b&gt;zoom × 0,95 im HTML ersetzen, erneut drucken&lt;/b&gt;&lt;br&gt;höchstens 6 Durchläufe, Untergrenze 0,62" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col11"><mxGeometry x="380" y="1680" width="250" height="75" as="geometry"/></mxCell>
<mxCell id="m24" value="&lt;b&gt;bewerbungen/Lebenslauf_&amp;lt;Name&amp;gt;[_&amp;lt;Zusatz&amp;gt;].pdf&lt;/b&gt;&lt;br&gt;Antwort mit Pfad, Seitenzahl und Datum" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col11"><mxGeometry x="20" y="1790" width="330" height="47" as="geometry"/></mxCell>
<mxCell id="m25" value="&lt;b&gt;workflow_hinweis() – eine Quelle für alles&lt;/b&gt;&lt;br&gt;hängt an Bewerbungs- und Interview-Prompts den Verweis auf profil.json + lebenslauf.json an („bei Widerspruch zu älteren Dokumenten gelten diese Dateien“) → Spalte 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col11"><mxGeometry x="20" y="1867" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="o1" value="&lt;b&gt;Unterlagen (#dokumente)&lt;/b&gt;&lt;br&gt;sechs Reiter: Stammdaten · Zertifikate, Projekte, Eigene Abschnitte · Zeugnisse &amp;amp; Nachweise · Anschreiben · Bewerbungsmappe · Nach Bewerbung" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col12"><mxGeometry x="20" y="48" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="o2" value="&lt;b&gt;Upload per Drag &amp;amp; Drop (mehrere Dateien)&lt;/b&gt;&lt;br&gt;PNG, JPG oder PDF → POST /api/unterlagen/upload → lade_hoch()" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col12"><mxGeometry x="20" y="168" width="330" height="61" as="geometry"/></mxCell>
<mxCell id="o3" value="Typ und Größe in Ordnung?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col12"><mxGeometry x="20" y="259" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="o4" value="&lt;b&gt;ValueError: „Datei beschädigt“ · „größer als 15 MB“ · „Nur PDF, PNG oder JPG erlaubt“&lt;/b&gt;&lt;br&gt;geprüft wird die Signatur (%PDF, PNG, JPEG), nicht die Endung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col12"><mxGeometry x="380" y="256" width="250" height="90" as="geometry"/></mxCell>
<mxCell id="o5" value="&lt;b&gt;Ablegen: _sicherer_name() + _vorschau()&lt;/b&gt;&lt;br&gt;bereinigter Dateiname, bei Kollision _2, _3 … · Ziel unterlagen/zertifikate/ oder unterlagen/nachweise/ · Miniatur (PNG, 480 px): PDF per pdftoppm (erste Seite), Bild per sips" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col12"><mxGeometry x="20" y="373" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="o6" value="unterlagen/ (+ .vorschau/)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col12"><mxGeometry x="380" y="394" width="250" height="48" as="geometry"/></mxCell>
<mxCell id="o7" value="&lt;b&gt;„Auslesen“ (Zertifikat) / „Auswerten“ (Zeugnis)&lt;/b&gt;&lt;br&gt;POST /api/unterlagen/auslesen bzw. /api/nachweise/auswerten · Pfad muss per _in_unterlagen() in unterlagen/ liegen" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col12"><mxGeometry x="20" y="493" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="o8" value="&lt;b&gt;claude_datei(datei, prompt)&lt;/b&gt;&lt;br&gt;claude -p --model sonnet --allowedTools Read (nur lesen) · Arbeitsordner = Ordner der Datei · PDF-Text als Zusatz (≤ 12.000 Zeichen) · Timeout 240 s · Antwort muss JSON sein" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col12"><mxGeometry x="20" y="613" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="o9" value="Claude Code CLI" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="col12"><mxGeometry x="380" y="636" width="250" height="44" as="geometry"/></mxCell>
<mxCell id="o10" value="&lt;b&gt;Ergebnis ins Formular&lt;/b&gt;&lt;br&gt;ZERT_PROMPT: Zertifikat, Aussteller, Datum, Nummer, URL, 3–8 Skills – nur was dort steht · NACHWEIS_PROMPT: Zeugnissprache entschlüsseln, Gesamtnote, versteckte negative Formulierungen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col12"><mxGeometry x="20" y="733" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="o11" value="&lt;b&gt;Zeugnisse &amp;amp; Nachweise pflegen&lt;/b&gt;&lt;br&gt;Art wird aus dem Dateinamen geraten (Arbeitszeugnis … Sonstiges) · Titel, Aussteller, Datum, Note, Notiz · bei Referenz Name, Position, Telefon, E-Mail · Hinweis auf fehlende typische Unterlagen → POST /api/nachweise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col12"><mxGeometry x="20" y="853" width="330" height="104" as="geometry"/></mxCell>
<mxCell id="o12" value="nachweise.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col12"><mxGeometry x="380" y="881" width="250" height="48" as="geometry"/></mxCell>
<mxCell id="o13" value="&lt;b&gt;Reiter „Bewerbungsmappe“&lt;/b&gt;&lt;br&gt;Firma wählen → mappeVorauswahl(): passendes Anschreiben, aktueller Lebenslauf aus dem Editor, Position aus der Pipeline · Zeugnisse, Zertifikate, Dateien anhaken, Reihenfolge ändern, Deckblatt an/aus" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=11;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="col12"><mxGeometry x="20" y="987" width="330" height="104" as="geometry"/></mxCell>
<mxCell id="o14" value="&lt;b&gt;POST /api/mappe → baue_mappe(daten)&lt;/b&gt;&lt;br&gt;bis zu 40 Teile: {art: cv} oder {art: datei, pfad, titel}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col12"><mxGeometry x="20" y="1121" width="330" height="61" as="geometry"/></mxCell>
<mxCell id="o15" value="pdfunite da und mind. 1 Teil?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col12"><mxGeometry x="20" y="1212" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="o16" value="RuntimeError „pdfunite fehlt – brew install poppler“ · ValueError „Bitte mindestens ein Dokument auswählen“" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col12"><mxGeometry x="380" y="1224" width="250" height="61" as="geometry"/></mxCell>
<mxCell id="o17" value="Pfad in _erlaubt()?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col12"><mxGeometry x="20" y="1326" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="o18" value="&lt;b&gt;ValueError „nicht gefunden oder nicht erlaubt“&lt;/b&gt;&lt;br&gt;Schutz vor Pfad-Tricks: erlaubt sind PDF, PNG, JPG, DOCX in bewerbungen/, unterlagen/ und im Projektordner – ohne .vorschau, ~$-Dateien und Bewerbungsmappe_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col12"><mxGeometry x="380" y="1309" width="250" height="118" as="geometry"/></mxCell>
<mxCell id="o19" value="&lt;b&gt;Jeder Teil wird zu einer PDF&lt;/b&gt;&lt;br&gt;• cv: HTML aus dem Editor → Chrome headless&lt;br&gt;• .pdf: kopiert&lt;br&gt;• .docx: _docx_zu_pdf() – Microsoft Word per AppleScript (originalgetreu), Fallback textutil + Chrome&lt;br&gt;• Bild: _bild_zu_pdf() – auf A4 zentriert gesetzt" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bfa95a;fontSize=10;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;" vertex="1" parent="col12"><mxGeometry x="20" y="1440" width="330" height="100" as="geometry"/></mxCell>
<mxCell id="o20" value="&lt;b&gt;Deckblatt (optional)&lt;/b&gt;&lt;br&gt;_deckblatt(): HTML mit Name, Position, Firma, Kontakt und Inhaltsverzeichnis der Teile → PDF, wird vorn eingefügt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col12"><mxGeometry x="20" y="1570" width="330" height="75" as="geometry"/></mxCell>
<mxCell id="o21" value="&lt;b&gt;pdfunite → Bewerbungsmappe_&amp;lt;Firma&amp;gt;.pdf&lt;/b&gt;&lt;br&gt;nur ein Teil: einfach kopiert · Fehler beim Zusammenführen: „Zusammenführen fehlgeschlagen“" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col12"><mxGeometry x="20" y="1675" width="330" height="61" as="geometry"/></mxCell>
<mxCell id="o22" value="bewerbungen/Bewerbungsmappe_&amp;lt;Firma&amp;gt;.pdf" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="col12"><mxGeometry x="380" y="1678" width="250" height="56" as="geometry"/></mxCell>
<mxCell id="o23" value="Größer als 5 MB?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="col12"><mxGeometry x="20" y="1766" width="330" height="84" as="geometry"/></mxCell>
<mxCell id="o24" value="Warnung: viele Bewerbungsportale lehnen das ab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="col12"><mxGeometry x="380" y="1784" width="250" height="47" as="geometry"/></mxCell>
<mxCell id="o25" value="&lt;b&gt;Ergebnis&lt;/b&gt;&lt;br&gt;Pfad, Seitenzahl und Dateigröße · die Mappe erscheint auch unter „Nach Bewerbung“ (Spalte 7)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="col12"><mxGeometry x="20" y="1880" width="330" height="61" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;JobScout.app (Desktop)&lt;/b&gt;&lt;br&gt;AppleScript-Applet mit violettem Lupen-Icon (assets/JobScout.icns); alternativ run_cockpit.command per Doppelklick im Finder" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=10;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="start"><mxGeometry x="20" y="46" width="280" height="64" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;start_cockpit.sh&lt;/b&gt;&lt;br&gt;curl auf /api/status (Port 8766): läuft das Cockpit? sonst nohup python3 jobscout_app.py --kein-browser (Log .cockpit/server.log), bis zu 20× warten, dann open URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="start"><mxGeometry x="340" y="46" width="360" height="64" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;jobscout_app.py: HTTP-Server&lt;/b&gt;&lt;br&gt;ThreadingHTTPServer auf 127.0.0.1 (JOBSCOUT_PORT, Standard 8765, Starter 8766) · Host-Prüfung · schreibende Aufrufe nur mit Header X-JobScout: 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="start"><mxGeometry x="740" y="46" width="420" height="64" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;Browser: Single-Page-App (app/)&lt;/b&gt;&lt;br&gt;index.html + app.js mit Hash-Router, einstellungen.js, lebenslauf.js · spricht per fetch die /api/…-Endpunkte an (Vanilla JS, kein Build)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=4;" vertex="1" parent="start"><mxGeometry x="1200" y="46" width="380" height="64" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;10 Ansichten&lt;/b&gt;&lt;br&gt;Dashboard · Mein Profil · Stellen · Pipeline · Lebenslauf-Editor · Unterlagen · Interview-Prep · Skill-Radar · Einstellungen · Automatisierungen" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#d5f0e8;strokeColor=#2d9c7f;fontSize=10;align=left;spacingLeft=18;spacingRight=14;" vertex="1" parent="start"><mxGeometry x="1620" y="46" width="420" height="64" as="geometry"/></mxCell>
<mxCell id="s6" value="&lt;b&gt;Externe Systeme&lt;/b&gt;&lt;br&gt;Jobsuche-APIs (Arbeitsagentur, Adzuna, Arbeitnow, Himalayas) · LinkedIn-MCP · Claude Code CLI · Chrome · Word · Poppler · Terminal.app" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="start"><mxGeometry x="2080" y="46" width="480" height="64" as="geometry"/></mxCell>
<mxCell id="store" value="Datenhaltung (alles lokal im Projektordner; persönliche Daten, Zugangsdaten und Laufergebnisse sind per .gitignore vom Git ausgeschlossen)" style="swimlane;startSize=34;html=1;rounded=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#666666;fontStyle=1;fontSize=14;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="6731" width="2590" height="150" as="geometry"/></mxCell>
<mxCell id="st0" value="einstellungen.json (Spalte 1 → 3, 9, 10; im Repo)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="store"><mxGeometry x="20" y="52" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="st1" value="jobs_gesehen.db: gesehen, radar_snapshot (Spalte 3, 9, 10)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="store"><mxGeometry x="255" y="52" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="st2" value="jobs_ranked.csv / jobs_report.html (Spalte 3, 6, 9)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="store"><mxGeometry x="490" y="52" width="200" height="76" as="geometry"/></mxCell>
